# Seeker Estates static site (generated by build.py)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteRule ^reservation/ /book/ [L,R=301]
RewriteRule ^reservation/?$ /book/ [L,R=301]
RewriteRule ^property-list/ /stays/ [L,R=301]
RewriteRule ^property-list/?$ /stays/ [L,R=301]
RewriteRule ^property/st-johns-wood-nw8 /areas/st-johns-wood/ [L,R=301]
RewriteRule ^property/wellington-road-nw8 /areas/st-johns-wood/ [L,R=301]
RewriteRule ^property/finchley-road-nw8 /areas/st-johns-wood/ [L,R=301]
RewriteRule ^property/warwick-avenue-w9 /areas/st-johns-wood/ [L,R=301]
RewriteRule ^property/paddington-w2 /areas/notting-hill-bayswater/ [L,R=301]
RewriteRule ^property/marble-arch-w2 /areas/notting-hill-bayswater/ [L,R=301]
RewriteRule ^property/gloucester-terrace /areas/notting-hill-bayswater/ [L,R=301]
RewriteRule ^property/mayfair-w1k /areas/marylebone/ [L,R=301]
RewriteRule ^property/ /stays/ [L,R=301]
RewriteRule ^category/ /stays/ [L,R=301]
RewriteRule ^thank-you/ / [L,R=301]
RewriteRule ^thank-you/?$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options nosniff
Header set Referrer-Policy strict-origin-when-cross-origin
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
