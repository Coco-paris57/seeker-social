# Seeker Concierge configuration. Copy to .env (never commit it) or set these in your host.

# Public https address of this service. QR codes and notification links are built from it,
# so set it before printing any QR code.
BASE_URL=https://concierge.example.com
PORT=8787
NODE_ENV=production
# Where the SQLite database lives. Must be a persistent disk.
DATA_DIR=/data
# Number of reverse proxies in front of the app (1 on Fly.io, Render, Railway).
TRUST_PROXY=1

# Claude API key from console.anthropic.com. Without it the app runs in demo mode
# (keyword matching, no AI).
ANTHROPIC_API_KEY=
# CONCIERGE_MODEL=claude-opus-5-5
# CONCIERGE_EFFORT=medium

# Smoobu > Settings > Advanced > API Keys.
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
# Long random value (e.g. `openssl rand -hex 24`). Part of the webhook address.
SMOOBU_WEBHOOK_TOKEN=
# on = also answer guest messages that arrive through Smoobu (Airbnb, Booking.com, email).
# Leave off until the web chat has been running in learning mode for a while.
SMOOBU_INBOX=off

# Shown in the guest privacy notice.
COMPANY_NAME=Seeker Estates LTD
PRIVACY_EMAIL=

# Push notifications. Keys are generated and stored on first run if left empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@seekerestates.com
# Optional: also send alerts to a Slack-compatible incoming webhook.
# NOTIFY_WEBHOOK_URL=

# Code needed to create the first administrator in production. Generated and printed in the
# server log on first start if left empty.
# SETUP_TOKEN=
# Overall ceiling on guest messages handled per hour (protects against abuse and runaway cost).
# MAX_MESSAGES_PER_HOUR=600
